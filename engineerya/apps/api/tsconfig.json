{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@engineerya/config": ["../../packages/config/src"],
      "@engineerya/database": ["../../packages/database/src"],
      "@engineerya/shared-types": ["../../packages/shared-types/src"]
    }
  }
}
